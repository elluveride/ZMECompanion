{
  "name": "zme-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Second-monitor position companion for ZME (Memphis ARTCC) VATSIM controllers.",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && npm run crosscheck && tsc -b && vite build",
    "preview": "vite preview",
    "validate": "tsx scripts/validate.ts",
    "crosscheck": "tsx scripts/crosscheck.ts",
    "staleness": "tsx scripts/staleness.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"schema/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"e2e/**/*.ts\"",
    "smoke:dev": "tsx scripts/dev-smoke.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
}
